{%- if section.settings.enable_section -%}
  {%- liquid
    assign max_items = section.settings.max_items | default: 8
    assign is_slider = false
    if section.settings.layout_style == 'slider'
      assign is_slider = true
    endif
  -%}

  <gkb-recently-viewed-section class="gkb-section gkb-recently-viewed" data-section-id="{{ section.id }}">
    {%- if product != blank -%}
      {%- assign current_variant = product.selected_or_first_available_variant -%}
      <script type="application/json" class="gkb-recently-viewed-data">
        {
          "id": {{ product.id | json }},
          "handle": {{ product.handle | json }},
          "title": {{ product.title | json }},
          "url": {{ product.url | json }},
          "image": {{ product.featured_media.preview_image | image_url: width: 640 | json }},
          "secondary_image": {{ product.media[1].preview_image | image_url: width: 640 | json }},
          "price": {{ current_variant.price | json }},
          "compare_at_price": {{ current_variant.compare_at_price | json }},
          "available": {{ current_variant.available | json }},
          "variant_id": {{ current_variant.id | json }},
          "vendor": {{ product.vendor | json }},
          "variants_count": {{ product.variants.size | json }}
        }
      </script>
    {%- endif -%}

    <div class="gkb-container">
      <div class="gkb-slider__header">
        <div class="gkb-header-group gkb-header-group--left">
          {%- if section.settings.eyebrow != blank -%}
            <span class="gkb-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="gkb-heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="gkb-subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>

        <div class="gkb-recently-viewed__actions">
          {%- if section.settings.show_clear_history -%}
            <button type="button" class="gkb-recently-viewed__clear-btn" aria-label="Clear recently viewed history">
              Clear All
            </button>
          {%- endif -%}

          {%- if is_slider -%}
            <div class="gkb-slider__nav">
              <button type="button" class="gkb-slider__btn gkb-slider__btn--prev" aria-label="Previous Recently Viewed Items">
                {%- render 'icon', icon: 'chevron-left' -%}
              </button>
              <button type="button" class="gkb-slider__btn gkb-slider__btn--next" aria-label="Next Recently Viewed Items">
                {%- render 'icon', icon: 'chevron-right' -%}
              </button>
            </div>
          {%- endif -%}
        </div>
      </div>

      <gkb-recently-viewed
        class="gkb-recently-viewed__body"
        data-current-product-id="{% if product != blank %}{{ product.id }}{% endif %}"
        data-max-items="{{ max_items }}"
        data-layout="{{ section.settings.layout_style }}"
        data-show-quick-add="{{ section.settings.show_quick_add }}"
        data-show-vendor="{{ section.settings.show_vendor }}"
      >
        {%- liquid
          assign store_products = collections.all.products
        -%}
        {%- if is_slider -%}
          <gkb-slider class="gkb-slider">
            <div class="gkb-slider__track" role="region" aria-label="Recently Viewed Products Carousel">
              {%- if store_products.size > 0 -%}
                {%- for item in store_products limit: max_items -%}
                  {%- render 'gkb-product-card',
                    product: item,
                    show_vendor: section.settings.show_vendor,
                    show_quick_add: section.settings.show_quick_add,
                    is_slide: true
                  -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </gkb-slider>
        {%- else -%}
          <div class="gkb-grid gkb-grid--4col">
            {%- if store_products.size > 0 -%}
              {%- for item in store_products limit: max_items -%}
                {%- render 'gkb-product-card',
                  product: item,
                  show_vendor: section.settings.show_vendor,
                  show_quick_add: section.settings.show_quick_add,
                  is_slide: false
                -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="gkb-recently-viewed__empty" hidden>
          <p class="gkb-subheading">You haven't viewed any other products yet.</p>
        </div>
      </gkb-recently-viewed>
    </div>
  </gkb-recently-viewed-section>
{%- endif -%}

{% schema %}
{
  "name": "Recently Viewed Products",
  "class": "gkb-section-recently-viewed",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your History"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pick up right where you left off."
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout Style",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximum items to display",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_clear_history",
      "label": "Show Clear History Button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed Products"
    }
  ]
}
{% endschema %}
